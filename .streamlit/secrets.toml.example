# Streamlit Secrets Configuration for Cloud Deployment
# 
# For Streamlit Cloud deployment on GitHub:
# 1. Go to https://share.streamlit.io/
# 2. Find your deployed app
# 3. Click "Manage app" → "Secrets"
# 4. Paste the contents of this file and fill in your actual API key
# 5. Replace "your-google-api-key-here" with your actual Google Gemini API key
#
# For local development:
# 1. Copy this file to .streamlit/secrets.toml (remove .example)
# 2. Fill in your actual API key
# 3. .streamlit/secrets.toml is automatically excluded from git (in .gitignore)

google_api_key = "your-google-api-key-here"
